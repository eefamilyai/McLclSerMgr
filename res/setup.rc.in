#include <windows.h>
#include "version.h"

1 ICON "@CMAKE_SOURCE_DIR@/res/app.ico"
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/res/app.manifest"
2 RCDATA "@PAYLOAD_EXE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VX_VERSION_NUM
 PRODUCTVERSION VX_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", VX_APP_NAME
            VALUE "FileDescription", "Voxual Setup - installs the Minecraft server manager"
            VALUE "FileVersion", VX_VERSION_STR
            VALUE "InternalName", "VoxualSetup"
            VALUE "OriginalFilename", "VoxualSetup.exe"
            VALUE "ProductName", VX_APP_NAME
            VALUE "ProductVersion", VX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
